{
  "name": "learning-ssg",
  "version": "1.0.0",
  "description": "Multi-course Mobile-First Static Site Generator for learning apps",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "ssg": "node scripts/ssg.js",
    "build": "node scripts/ssg.js build financial_planner && vite build",
    "test": "node --test",
    "build:data": "node scripts/ssg.js build financial_planner",
    "serve": "node scripts/ssg.js serve financial_planner",
    "list": "node scripts/ssg.js list",
    "new": "node scripts/ssg.js new",
    "import:social-psychology": "node scripts/import-social-psychology.js",
    "import:varian-microeconomics": "node scripts/import-varian-microeconomics.js",
    "import:chinese-language": "node scripts/import-chinese-language.js",
    "import:saito-macroeconomics": "node scripts/import-saito-macroeconomics.js",
    "import:mintzberg-organization": "node scripts/import-mintzberg-organization.js",
    "dev": "vite"
  },
  "keywords": [
    "ssg",
    "learning",
    "financial-planner",
    "mobile-first"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "devDependencies": {
    "vite": "^8.2.1"
  },
  "dependencies": {
    "katex": "^0.17.0",
    "marked": "^18.0.9",
    "marked-katex-extension": "^5.1.10"
  }
}
